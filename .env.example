# ===== DeepSeek API Key（必填）=====
# 到 https://platform.deepseek.com 申请，形如 sk-xxxx
DEEPSEEK_API_KEY=sk-xxxxxxxx

# 主持人模型（默认 deepseek-chat）
DEEPSEEK_MODEL=deepseek-chat

# DeepSeek API 地址（一般不用改）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ===== NapCat OneBot 连接 =====
# NapCat 网络配置里新建「WebSocket 服务器」端口 3001 后，这里保持默认即可
ONEBOT_WS_URL=ws://127.0.0.1:3001

# ===== 游戏规则 =====
# 每局提问上限
MAX_QUESTIONS=20

# 群里是否必须 @ 机器人才回复（true=要@；false=所有群消息都响应）
GROUP_REQUIRE_AT=true

# 允许开局的管理员 QQ 号（逗号分隔；留空 = 任何人都能开局）
ADMIN_QIDS=
